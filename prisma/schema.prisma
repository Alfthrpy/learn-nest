generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas = ["public","extension"]
}

// ============================================
// RBAC Schema
// ============================================

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  first_name String
  last_name  String
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Relations
  position_id Int
  position    Position @relation(fields: [position_id], references: [id])

  place Place[]



  @@map("users")
  @@schema("public")
}

model Position {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  // Relations
  users                User[]
  position_permissions PositionPermission[]

  @@map("positions")
  @@schema("public")
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  resource    String // e.g., 'USER', 'TRANSACTION', 'REPORT'
  action      String // e.g., 'VIEW', 'ADD', 'UPDATE', 'DELETE'
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  // Relations
  position_permissions PositionPermission[]

  @@map("permissions")
  @@schema("public")
}

model PositionPermission {
  id            Int      @id @default(autoincrement())
  position_id   Int
  permission_id Int
  created_at    DateTime @default(now())

  // Relations
  position   Position   @relation(fields: [position_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([position_id, permission_id])
  @@map("position_permissions")
  @@schema("public")


}


model District {
  id          Int       @id @default(autoincrement())
  geom        Unsupported("geometry(Geometry, 4326)")
  name        String    @unique
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt 
  deleted_at  DateTime?

  places Place[]

  @@map("districts")
  @@schema("public")
}

model Place {
  id          Int       @id @default(autoincrement())
  point       Unsupported("geometry(Point, 4326)")
  name        String    @unique
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  user_id Int
  user    User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  district_id Int
  district     District  @relation(fields: [district_id], references: [id], onDelete: Cascade)

  @@map("places")
  @@schema("public")
  @@unique([name,user_id])
}