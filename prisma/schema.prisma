generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas = ["public","extension"]
}

// ============================================
// RBAC Schema
// ============================================

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  first_name String
  last_name  String
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Relations
  position_id Int
  position    Position @relation(fields: [position_id], references: [id])

  place Place[]



  @@map("users")
  @@schema("public")
}

model Position {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  // Relations
  users                User[]
  position_permissions PositionPermission[]

  @@map("positions")
  @@schema("public")
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  resource    String // e.g., 'USER', 'TRANSACTION', 'REPORT'
  action      String // e.g., 'VIEW', 'ADD', 'UPDATE', 'DELETE'
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  // Relations
  position_permissions PositionPermission[]

  @@map("permissions")
  @@schema("public")
}

model PositionPermission {
  id            Int      @id @default(autoincrement())
  position_id   Int
  permission_id Int
  created_at    DateTime @default(now())

  // Relations
  position   Position   @relation(fields: [position_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([position_id, permission_id])
  @@map("position_permissions")
  @@schema("public")


}


model District {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?

  feature_id  Int      @unique
  feature     Feature  @relation(fields: [feature_id], references: [id], onDelete: Restrict)

  places      Place[]

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  @@map("districts")
  @@schema("public")
}

model Place {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  is_active   Boolean  @default(true)

  feature_id  Int      @unique
  feature     Feature  @relation(fields: [feature_id], references: [id], onDelete: Restrict)

  district_id Int
  district    District @relation(fields: [district_id], references: [id], onDelete: Cascade )

  user_id     Int
  user        User @relation(fields: [user_id],references: [id], onDelete: Cascade)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  @@unique([name, user_id])
  @@index([district_id])
  @@index([user_id])
  @@map("places")
  @@schema("public")
}

model Layer {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  data_type   String?
  description String?
  properties  Json?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  features    Feature[]

  @@map("layers")
  @@schema("public")
}

model Feature {
  id          Int @id @default(autoincrement())

  geom        Unsupported("geometry(Geometry, 4326)")

  name        String?
  properties  Json?

  layer_id    Int
  layer       Layer @relation(fields: [layer_id], references: [id], onDelete: Cascade)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  district    District?
  place       Place?

  @@index([layer_id])
  @@map("features")
  @@schema("public")
}